{"ast":null,"code":"```jsx\nimport React from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { Navbar, Nav, Container, NavDropdown } from 'react-bootstrap'\nimport { LinkContainer } from 'react-router-bootstrap'\nimport { logout } from '../actions/userActions'\nimport { useHistory } from 'react-router-dom'\nimport SearchBarForProducts from './SearchBarForProducts'\n\nfunction NavBar() {\n\n    const history = useHistory()\n    const dispatch = useDispatch()\n\n    const userLoginReducer = useSelector(\n        state => state.userLoginReducer\n    )\n\n    const { userInfo } = userLoginReducer\n\n    const logoutHandler = () => {\n        dispatch(logout())\n        history.push('/login')\n        window.location.reload()\n    }\n\n    return (\n\n        <header className=\"shopease-header\">\n\n            <Navbar\n                expand=\"lg\"\n                collapseOnSelect\n                className=\"shopease-navbar\"\n            >\n\n                <Container fluid className=\"shopease-container\">\n\n                    {/* =================================\n                        LOGO\n                    ================================= */}\n\n                    <LinkContainer to=\"/\">\n\n                        <Navbar.Brand className=\"shopease-logo\">\n\n                            <div className=\"logo-icon\">\n                                🛍️\n                            </div>\n\n                            <div className=\"logo-text\">\n\n                                <span className=\"logo-name\">\n                                    ShopEase\n                                </span>\n\n                                <small>\n                                    Shop • Smile • Repeat\n                                </small>\n\n                            </div>\n\n                        </Navbar.Brand>\n\n                    </LinkContainer>\n\n\n                    {/* =================================\n                        MOBILE TOGGLE\n                    ================================= */}\n\n                    <Navbar.Toggle\n                        aria-controls=\"shopease-navbar\"\n                        className=\"shopease-toggle\"\n                    />\n\n\n                    <Navbar.Collapse\n                        id=\"shopease-navbar\"\n                    >\n\n                        {/* =================================\n                            SEARCH\n                        ================================= */}\n\n                        <div className=\"shopease-search\">\n\n                            <SearchBarForProducts />\n\n                        </div>\n\n\n                        {/* =================================\n                            NAVIGATION\n                        ================================= */}\n\n                        <Nav className=\"shopease-nav\">\n\n\n                            {/* Home */}\n\n                            <LinkContainer to=\"/\">\n\n                                <Nav.Link className=\"shopease-nav-link\">\n\n                                    <span className=\"nav-icon\">\n                                        🏠\n                                    </span>\n\n                                    <span>\n                                        Home\n                                    </span>\n\n                                </Nav.Link>\n\n                            </LinkContainer>\n\n\n                            {/* All Products */}\n\n                            <LinkContainer to=\"/\">\n\n                                <Nav.Link className=\"shopease-nav-link\">\n\n                                    <span className=\"nav-icon\">\n                                        🛒\n                                    </span>\n\n                                    <span>\n                                        Products\n                                    </span>\n\n                                </Nav.Link>\n\n                            </LinkContainer>\n\n\n                            {/* Admin */}\n\n                            {userInfo && userInfo.admin && (\n\n                                <LinkContainer to=\"/new-product/\">\n\n                                    <Nav.Link className=\"shopease-nav-link\">\n\n                                        <span className=\"nav-icon\">\n                                            ➕\n                                        </span>\n\n                                        <span>\n                                            Add Product\n                                        </span>\n\n                                    </Nav.Link>\n\n                                </LinkContainer>\n\n                            )}\n\n\n                            {/* =================================\n                                CART\n                            ================================= */}\n\n                            <Nav.Link\n                                className=\"shopease-nav-link cart-link\"\n                                onClick={() => history.push('/cart')}\n                            >\n\n                                <span className=\"nav-icon\">\n                                    🛍️\n                                </span>\n\n                                <span>\n                                    Cart\n                                </span>\n\n                            </Nav.Link>\n\n\n                            {/* =================================\n                                USER\n                            ================================= */}\n\n                            {userInfo ? (\n\n                                <NavDropdown\n                                    title={\n                                        <span className=\"profile-title\">\n\n                                            <span className=\"profile-icon\">\n                                                👤\n                                            </span>\n\n                                            <span>\n                                                {userInfo.username}\n                                            </span>\n\n                                        </span>\n                                    }\n                                    id=\"shopease-user-dropdown\"\n                                    align=\"right\"\n                                    className=\"shopease-profile\"\n                                >\n\n                                    <LinkContainer to=\"/account\">\n\n                                        <NavDropdown.Item>\n\n                                            👤 Account Settings\n\n                                        </NavDropdown.Item>\n\n                                    </LinkContainer>\n\n\n                                    <LinkContainer to=\"/all-addresses/\">\n\n                                        <NavDropdown.Item>\n\n                                            📍 Address Settings\n\n                                        </NavDropdown.Item>\n\n                                    </LinkContainer>\n\n\n                                    <LinkContainer to=\"/stripe-card-details/\">\n\n                                        <NavDropdown.Item>\n\n                                            💳 Card Settings\n\n                                        </NavDropdown.Item>\n\n                                    </LinkContainer>\n\n\n                                    <LinkContainer to=\"/all-orders/\">\n\n                                        <NavDropdown.Item>\n\n                                            📦 My Orders\n\n                                        </NavDropdown.Item>\n\n                                    </LinkContainer>\n\n\n                                    <NavDropdown.Divider />\n\n\n                                    <NavDropdown.Item\n                                        onClick={logoutHandler}\n                                    >\n\n                                        🚪 Logout\n\n                                    </NavDropdown.Item>\n\n                                </NavDropdown>\n\n                            ) : (\n\n                                <LinkContainer to=\"/login\">\n\n                                    <Nav.Link className=\"login-button\">\n\n                                        <span>\n                                            👤\n                                        </span>\n\n                                        Login / Sign Up\n\n                                    </Nav.Link>\n\n                                </LinkContainer>\n\n                            )}\n\n                        </Nav>\n\n                    </Navbar.Collapse>\n\n                </Container>\n\n            </Navbar>\n\n\n            {/* =================================\n                CATEGORY BAR\n            ================================= */}\n\n            <div className=\"category-navbar\">\n\n                <div className=\"category-navbar-inner\">\n\n\n                    <button\n                        onClick={() => history.push('/')}\n                        className=\"category-nav-item\"\n                    >\n                        Popular\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Kurtis')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Kurtis\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Sarees')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Sarees\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Lehengas')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Lehengas\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Women%20Western')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Women Western\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Men')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Men\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Kids%20%26%20Toys')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Kids & Toys\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Home%20%26%20Kitchen')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Home & Kitchen\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Beauty')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Beauty\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Jewellery')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Jewellery\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Bags%20%26%20Footwear')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Bags & Footwear\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Electronics')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Electronics\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Watches')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Watches\n                    </button>\n\n                </div>\n\n            </div>\n\n        </header>\n    )\n}\n\nexport default NavBar\n```;","map":{"version":3,"names":[],"sources":["D:/FullStack_Ecommerce_App-main/frontend/src/components/Navbar.js"],"sourcesContent":["```jsx\nimport React from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { Navbar, Nav, Container, NavDropdown } from 'react-bootstrap'\nimport { LinkContainer } from 'react-router-bootstrap'\nimport { logout } from '../actions/userActions'\nimport { useHistory } from 'react-router-dom'\nimport SearchBarForProducts from './SearchBarForProducts'\n\nfunction NavBar() {\n\n    const history = useHistory()\n    const dispatch = useDispatch()\n\n    const userLoginReducer = useSelector(\n        state => state.userLoginReducer\n    )\n\n    const { userInfo } = userLoginReducer\n\n    const logoutHandler = () => {\n        dispatch(logout())\n        history.push('/login')\n        window.location.reload()\n    }\n\n    return (\n\n        <header className=\"shopease-header\">\n\n            <Navbar\n                expand=\"lg\"\n                collapseOnSelect\n                className=\"shopease-navbar\"\n            >\n\n                <Container fluid className=\"shopease-container\">\n\n                    {/* =================================\n                        LOGO\n                    ================================= */}\n\n                    <LinkContainer to=\"/\">\n\n                        <Navbar.Brand className=\"shopease-logo\">\n\n                            <div className=\"logo-icon\">\n                                🛍️\n                            </div>\n\n                            <div className=\"logo-text\">\n\n                                <span className=\"logo-name\">\n                                    ShopEase\n                                </span>\n\n                                <small>\n                                    Shop • Smile • Repeat\n                                </small>\n\n                            </div>\n\n                        </Navbar.Brand>\n\n                    </LinkContainer>\n\n\n                    {/* =================================\n                        MOBILE TOGGLE\n                    ================================= */}\n\n                    <Navbar.Toggle\n                        aria-controls=\"shopease-navbar\"\n                        className=\"shopease-toggle\"\n                    />\n\n\n                    <Navbar.Collapse\n                        id=\"shopease-navbar\"\n                    >\n\n                        {/* =================================\n                            SEARCH\n                        ================================= */}\n\n                        <div className=\"shopease-search\">\n\n           