                                      </span>\n\n                                    </Nav.Link>\n\n                                </LinkContainer>\n\n                            )}\n\n\n                            {/* =================================\n                                CART\n                            ================================= */}\n\n                            <Nav.Link\n                                className=\"shopease-nav-link cart-link\"\n                                onClick={() => history.push('/cart')}\n                            >\n\n                                <span className=\"nav-icon\">\n                                    🛍️\n                                </span>\n\n                                <span>\n                                    Cart\n                                </span>\n\n                            </Nav.Link>\n\n\n                            {/* =================================\n                                USER\n                            ================================= */}\n\n                            {userInfo ? (\n\n                                <NavDropdown\n                                    title={\n                                        <span className=\"profile-title\">\n\n                                            <span className=\"profile-icon\">\n                                                👤\n                                            </span>\n\n                                            <span>\n                                                {userInfo.username}\n                                            </span>\n\n                                        </span>\n                                    }\n                                    id=\"shopease-user-dropdown\"\n                                    align=\"right\"\n                                    className=\"shopease-profile\"\n                                >\n\n                                    <LinkContainer to=\"/account\">\n\n                                        <NavDropdown.Item>\n\n                                            👤 Account Settings\n\n                                        </NavDropdown.Item>\n\n                                    </LinkContainer>\n\n\n                                    <LinkContainer to=\"/all-addresses/\">\n\n                                        <NavDropdown.Item>\n\n                                            📍 Address Settings\n\n                                        </NavDropdown.Item>\n\n                                    </LinkContainer>\n\n\n                                    <LinkContainer to=\"/stripe-card-details/\">\n\n                                        <NavDropdown.Item>\n\n                                            💳 Card Settings\n\n                                        </NavDropdown.Item>\n\n                                    </LinkContainer>\n\n\n                                    <LinkContainer to=\"/all-orders/\">\n\n                                        <NavDropdown.Item>\n\n                                            📦 My Orders\n\n                                        </NavDropdown.Item>\n\n                                    </LinkContainer>\n\n\n                                    <NavDropdown.Divider />\n\n\n                                    <NavDropdown.Item\n                                        onClick={logoutHandler}\n                                    >\n\n                                        🚪 Logout\n\n                                    </NavDropdown.Item>\n\n                                </NavDropdown>\n\n                            ) : (\n\n                                <LinkContainer to=\"/login\">\n\n                                    <Nav.Link className=\"login-button\">\n\n                                        <span>\n                                            👤\n                                        </span>\n\n                                        Login / Sign Up\n\n                                    </Nav.Link>\n\n                                </LinkContainer>\n\n                            )}\n\n                        </Nav>\n\n                    </Navbar.Collapse>\n\n                </Container>\n\n            </Navbar>\n\n\n            {/* =================================\n                CATEGORY BAR\n            ================================= */}\n\n            <div className=\"category-navbar\">\n\n                <div className=\"category-navbar-inner\">\n\n\n                    <button\n                        onClick={() => history.push('/')}\n                        className=\"category-nav-item\"\n                    >\n                        Popular\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Kurtis')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Kurtis\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Sarees')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Sarees\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Lehengas')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Lehengas\n                    </button>\n\n\n                    <button\n                        onClick={() =>\n                            history.push('/?category=Women%20Western')\n                        }\n                        className=\"category-nav-item\"\n                    >\n                        Women Western\n            