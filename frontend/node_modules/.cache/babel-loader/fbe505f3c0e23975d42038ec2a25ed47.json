{"ast":null,"code":"```jsx\nimport React, { useState, useEffect } from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { Link } from 'react-router-dom'\nimport { Form } from 'react-bootstrap'\nimport { login } from '../actions/userActions'\nimport Message from '../components/Message'\n\nimport '../styles/Login.css'\n\nfunction LoginPage({ history }) {\n\n    const [username, setUsername] = useState(\"\")\n    const [password, setPassword] = useState(\"\")\n    const [showPassword, setShowPassword] = useState(false)\n\n    const dispatch = useDispatch()\n\n    // =========================================\n    // REDUX\n    // =========================================\n\n    const userLoginReducer = useSelector(\n        state => state.userLoginReducer\n    )\n\n    const {\n        error,\n        userInfo,\n        loading\n    } = userLoginReducer\n\n\n    // =========================================\n    // REDIRECT AFTER LOGIN\n    // =========================================\n\n    useEffect(() => {\n\n        if (userInfo) {\n            history.push('/')\n        }\n\n    }, [history, userInfo])\n\n\n    // =========================================\n    // LOGIN HANDLER\n    // =========================================\n\n    const submitHandler = (e) => {\n\n        e.preventDefault()\n\n        dispatch(\n            login(\n                username,\n                password\n            )\n        )\n    }\n\n\n    return (\n\n        <div className=\"login-page\">\n\n            <div className=\"login-card\">\n\n                {/* =================================\n                    LEFT BRAND SECTION\n                ================================= */}\n\n                <div className=\"login-brand\">\n\n                    <div className=\"login-brand-content\">\n\n                        <div className=\"login-logo\">\n                            🛍️\n                        </div>\n\n                        <h1>\n                            Shop<span>Ease</span>\n                        </h1>\n\n                        <p className=\"login-tagline\">\n                            Shop smarter. Live better.\n                        </p>\n\n\n                        <div className=\"login-welcome\">\n\n                            <h2>\n                                Welcome Back! 👋\n                            </h2>\n\n                            <p>\n                                Sign in to discover amazing products\n                                and continue your shopping journey.\n                            </p>\n\n                        </div>\n\n\n                        <div className=\"login-benefits\">\n\n                            <div className=\"login-benefit\">\n                                <span>✓</span>\n                                <p>Discover amazing products</p>\n                            </div>\n\n                            <div className=\"login-benefit\">\n                                <span>✓</span>\n                                <p>Fast & secure checkout</p>\n                            </div>\n\n                            <div className=\"login-benefit\">\n                                <span>✓</span>\n                                <p>Track your orders easily</p>\n                            </div>\n\n                        </div>\n\n                    </div>\n\n                    <div className=\"login-decoration decoration-one\"></div>\n                    <div className=\"login-decoration decoration-two\"></div>\n\n                </div>\n\n\n                {/* =================================\n                    RIGHT FORM SECTION\n                ================================= */}\n\n                <div className=\"login-form-section\">\n\n                    <div className=\"login-form-wrapper\">\n\n\n                        {/* HEADING */}\n\n                        <div className=\"login-heading\">\n\n                            <span className=\"login-small-title\">\n                                ACCOUNT LOGIN\n                            </span>\n\n                            <h2>\n                                Sign In\n                            </h2>\n\n                            <p>\n                                Welcome back! Please enter your\n                                details to continue.\n                            </p>\n\n                        </div>\n\n\n                        {/* ERROR */}\n\n                        {error && (\n\n                            <div className=\"login-error\">\n\n                                <Message variant=\"danger\">\n                                    {error}\n                                </Message>\n\n                            </div>\n\n                        )}\n\n\n                        {/* FORM */}\n\n                        <Form onSubmit={submitHandler}>\n\n\n                            {/* USERNAME */}\n\n                            <Form.Group\n                                controlId=\"username\"\n                                className=\"login-form-group\"\n                            >\n\n                                <Form.Label>\n                                    Username\n                                </Form.Label>\n\n                                <div className=\"login-input\">\n\n                                    <span className=\"input-icon\">\n                                        👤\n                                    </span>\n\n                                    <Form.Control\n                                        type=\"text\"\n                                        placeholder=\"Enter your username\"\n                                        value={username}\n                                        onChange={(e) =>\n                                            setUsername(e.target.value)\n                                        }\n                                        required\n                                    />\n\n                                </div>\n\n                            </Form.Group>\n\n\n                            {/* PASSWORD */}\n\n                            <Form.Group\n                                controlId=\"password\"\n                                className=\"login-form-group\"\n                            >\n\n                                <div className=\"password-label-row\">\n\n                                    <Form.Label>\n                                        Password\n                                    </Form.Label>\n\n                                </div>\n\n                                <div className=\"login-input\">\n\n                                    <span className=\"input-icon\">\n                                        🔒\n                                    </span>\n\n                                    <Form.Control\n                                        type={\n                                            showPassword\n                                                ? \"text\"\n                                                : \"password\"\n                                        }\n                                        placeholder=\"Enter your password\"\n                                        value={password}\n                                        onChange={(e) =>\n                                            setPassword(e.target.value)\n                                        }\n                                        required\n                                    />\n\n                                    <button\n                                        type=\"button\"\n                                        className=\"password-toggle\"\n                                        onClick={() =>\n                                            setShowPassword(!showPassword)\n                                        }\n                                        aria-label=\"Toggle password visibility\"\n                                    >\n                                        {showPassword ? \"🙈\" : \"👁️\"}\n                                    </button>\n\n                                </div>\n\n                            </Form.Group>\n\n\n                            {/* LOGIN BUTTON */}\n\n                            <button\n                                type=\"submit\"\n                                className=\"login-submit-btn\"\n                                disabled={loading}\n                            >\n\n                                {loading ? (\n                                    <>\n                                        <span className=\"login-spinner\"></span>\n                                        Signing In...\n                                    </>\n                                ) : (\n                                    <>\n                                        Sign In\n                                        <span className=\"login-arrow\">\n                                            →\n                                        </span>\n                                    </>\n                                )}\n\n                            </button>\n\n                        </Form>\n\n\n                        {/* REGISTER */}\n\n                        <div className=\"login-register\">\n\n                            <span>\n                                New to ShopEase?\n                            </span>\n\n                            <Link to=\"/register\">\n                                Create an account\n                            </Link>\n\n                        </div>\n\n\n                        {/* SECURITY */}\n\n                        <div className=\"login-security\">\n\n                            <span>🔒</span>\n\n                            <p>\n                                Your login information is securely protected.\n                            </p>\n\n                        </div>\n\n                    </div>\n\n                </div>\n\n            </div>\n\n        </div>\n    )\n}\n\nexport default LoginPage\n```;","map":{"version":3,"names":[],"sources":["D:/FullStack_Ecommerce_App-main/frontend/src/pages/LoginPage.js"],"sourcesContent":["```jsx\nimport React, { useState, useEffect } from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { Link } from 'react-router-dom'\nimport { Form } from 'react-bootstrap'\nimport { login } from '../actions/userActions'\nimport Message from '../components/Message'\n\nimport '../styles/Login.css'\n\nfunction LoginPage({ history }) {\n\n    const [username, setUsername] = useState(\"\")\n    const [password, setPassword] = useState(\"\")\n    const [showPassword, setShowPassword] = useState(false)\n\n    const dispatch = useDispatch()\n\n    // =========================================\n    // REDUX\n    // =========================================\n\n    const userLoginReducer = useSelector(\n        state => state.userLoginReducer\n    )\n\n    const {\n        error,\n        userInfo,\n        loading\n    } = userLoginReducer\n\n\n    // =========================================\n    // REDIRECT AFTER LOGIN\n    // =========================================\n\n    useEffect(() => {\n\n        if (userInfo) {\n            history.push('/')\n        }\n\n    }, [history, userInfo])\n\n\n    // =========================================\n    // LOGIN HANDLER\n    // =========================================\n\n    const submitHandler = (e) => {\n\n        e.preventDefault()\n\n        dispatch(\n            login(\n                username,\n                password\n            )\n        )\n    }\n\n\n    return (\n\n        <div className=\"login-page\">\n\n            <div className=\"login-card\">\n\n                {/* =================================\n                    LEFT BRAND SECTION\n                ================================= */}\n\n                <div className=\"login-brand\">\n\n                    <div className=\"login-brand-content\">\n\n                        <div className=\"login-logo\">\n                            🛍️\n                        </div>\n\n                        <h1>\n                            Shop<span>Ease</span>\n                        </h1>\n\n                        <p className=\"login-tagline\">\n                            Shop smarter. Live better.\n                        </p>\n\n\n                        <div className=\"login-welcome\">\n\n                            <h2>\n                                Welcome Back! 👋\n                            </h2>\n\n                            <p>\n                                Sign in to discover amazing products\n                                and continue your shopping journey.\n                            </p>\n\n                        </div>\n\n\n                        <div className=\"login-benefits\">\n\n                            <div className=\"login-benefit\">\n                                <span>✓</span>\n                                <p>Discover amazing products</p>\n                            </div>\n\n                            <div className=\"login-benefit\">\n                                <span>✓</span>\n                                <p>Fast & secure checkout</p>\n                            </div>\n\n                            <div className=\"login-benefit\">\n                                <span>✓</span>\n                                <p>Track your orders easily</p>\n                            </div>\n\n                        </div>\n\n                    </div>\n\n                    <div className=\"login-decoration decoration-one\"></div>\n                    <div className=\"login-decoration decoration-two\"></div>\n\n                </div>\n\n\n                {/* =================================\n                    RIGHT FORM SECTION\n                ================================= */}\n\n                <div className=\"login-form-section\">\n\n                    <div className=\"login-form-wrapper\">\n\n\n                        {/* HEADING */}\n\n                        <div className=\"login-heading\">\n\n                            <span className=\"login-small-title\">\n                                ACCOUNT LOGIN\n                            </span>\n\n                            <h2>\n                                Sign In\n                            </h2>\n\n                            <p>\n                                Welcome back! Please enter your\n                                details to continue.\n                            </p>\n\n                        </div>\n\n\n                        {/* ERROR */}\n\n                        {error && (\n\n                            <div className=\"login-error\">\n\n                                <Message variant=\"danger\">\n                                    {error}\n                                </Message>\n\n                            </div>\n\n                        )}\n\n\n                        {/* FORM */}\n\n                        <Form onSubmit={submitHandler}>\n\n\n                            {/* USERNAME */}\n\n                            <Form.Group\n                                controlId=\"username\"\n                                className=\"login-form-group\"\n                            >\n\n                                <Form.Label>\n                                    Username\n                                </Form.Label>\n\n                                <div className=\"login-input\">\n\n                                    <span className=\"input-icon\">\n                                        👤\n                                    </span>\n\n                                    <Form.Control\n                                        type=\"text\"\n                                        placeholder=\"Enter your username\"\n                                        value={username}\n                                        onChange={(e) =>\n                                            setUsername(e.target.value)\n                                        }\n                                        required\n                                    />\n\n                                </div>\n\n                            </Form.Group>\n\n\n                            {/* PASSWORD */}\n\n                            <Form.Group\n                                controlId=\"password\"\n                                className=\"login-form-group\"\n                            >\n\n                                <div className=\"password-label-row\">\n\n                                    <Form.Label>\n                                        Password\n                                    </Form.Label>\n\n                                </div>\n\n                                <div className=\"login-input\">\n\n                                    <span className=\"input-icon\">\n                                        🔒\n                                    </span>\n\n                                    <Form.Control\n                                        type={\n                                            showPassword\n                                                ? \"text\"\n                                                : \"password\"\n                                        }\n                                        placeholder=\"Enter your password\"\n                                        value={password}\n                                        onChange={(e) =>\n                                            setPassword(e.target.value)\n                                        }\n                                        required\n                                    />\n\n                                    <button\n                                        type=\"button\"\n                                        className=\"password-toggle\"\n                                        onClick={() =>\n                                            setShowPassword(!showPassword)\n                                        }\n                                        aria-label=\"Toggle password visibility\"\n                                    >\n                                        {showPassword ? \"🙈\" : \"👁️\"}\n                                    </button>\n\n                                </div>\n\n                            </Form.Group>\n\n\n                            {/* LOGIN BUTTON */}\n\n                            <button\n                                type=\"submit\"\n                                className=\"login-submit-btn\"\n                                disabled={loading}\n                            >\n\n                                {loading ? (\n                                    <>\n                                        <span className=\"login-spinner\"></span>\n                                        Signing In...\n                                    </>\n                                ) : (\n                                    <>\n                                        Sign In\n                                        <span className=\"login-arrow\">\n                                            →\n                                        </span>\n                                    </>\n                                )}\n\n                            </button>\n\n                        </Form>\n\n\n                        {/* REGISTER */}\n\n                        <div className=\"login-register\">\n\n                            <span>\n                                New to ShopEase?\n                            </span>\n\n                            <Link to=\"/register\">\n                                Create an account\n                            </Link>\n\n                        </div>\n\n\n                        {/* SECURITY */}\n\n                        <div className=\"login-security\">\n\n                            <span>🔒</span>\n\n                            <p>\n                                Your login information is securely protected.\n                            </p>\n\n                        </div>\n\n                    </div>\n\n                </div>\n\n            </div>\n\n        </div>\n    )\n}\n\nexport default LoginPage\n```\n"],"mappings":"AAAA,EAAE;AACF;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;A