{"ast":null,"code":"```javascript\nimport React from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { Navbar, Nav, Container, NavDropdown } from 'react-bootstrap'\nimport { LinkContainer } from 'react-router-bootstrap'\nimport { logout } from '../actions/userActions'\nimport { useHistory } from \"react-router-dom\"\nimport SearchBarForProducts from './SearchBarForProducts'\n\nfunction NavBar() {\n\n    let history = useHistory()\n    const dispatch = useDispatch()\n\n    const userLoginReducer = useSelector(\n        state => state.userLoginReducer\n    )\n\n    const { userInfo } = userLoginReducer\n\n    const logoutHandler = () => {\n        dispatch(logout())\n        history.push(\"/login\")\n        window.location.reload()\n    }\n\n    return (\n        <header>\n\n            <Navbar bg=\"dark\" variant=\"dark\" expand=\"lg\" collapseOnSelect>\n\n                <Container>\n\n                    <LinkContainer to=\"/\">\n                        <Navbar.Brand>\n                            <i className=\"mb-2 fas fa-home\"> Home</i>\n                        </Navbar.Brand>\n                    </LinkContainer>\n\n                    <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n\n                    <Navbar.Collapse id=\"basic-navbar-nav\">\n\n                        <Nav className=\"mr-auto\">\n\n                            <LinkContainer to=\"/\">\n                                <Nav.Link>\n                                    All Products\n                                </Nav.Link>\n                            </LinkContainer>\n\n                            {userInfo && userInfo.admin ? (\n                                <LinkContainer to=\"/new-product/\">\n                                    <Nav.Link>\n                                        Add Product\n                                    </Nav.Link>\n                                </LinkContainer>\n                            ) : null}\n\n                            <span>\n                                <SearchBarForProducts />\n                            </span>\n\n                        </Nav>\n\n                        {userInfo ? (\n\n                            <div>\n\n                                <NavDropdown\n                                    className=\"navbar-nav text-capitalize\"\n                                    title={userInfo.username}\n                                    id=\"username\"\n                                >\n\n                                    <LinkContainer to=\"/account\">\n                                        <NavDropdown.Item>\n                                            Account Settings\n                                        </NavDropdown.Item>\n                                    </LinkContainer>\n\n                                    <LinkContainer to=\"/all-addresses/\">\n                                        <NavDropdown.Item>\n                                            Address Settings\n                                        </NavDropdown.Item>\n                                    </LinkContainer>\n\n                                    <LinkContainer to=\"/stripe-card-details/\">\n                                        <NavDropdown.Item>\n                                            Card Settings\n                                        </NavDropdown.Item>\n                                    </LinkContainer>\n\n                                    <LinkContainer to=\"/all-orders/\">\n                                        <NavDropdown.Item>\n                                            All Orders\n                                        </NavDropdown.Item>\n                                    </LinkContainer>\n\n                                    <NavDropdown.Item onClick={logoutHandler}>\n                                        Logout\n                                    </NavDropdown.Item>\n\n                                </NavDropdown>\n\n                            </div>\n\n                        ) : (\n\n                            <LinkContainer to=\"/login\">\n                                <Nav.Link>\n                                    <i className=\"fas fa-user\"></i> Login\n                                </Nav.Link>\n                            </LinkContainer>\n\n                        )}\n\n                    </Navbar.Collapse>\n\n                </Container>\n\n            </Navbar>\n\n        </header>\n    )\n}\n\nexport default NavBar\n```;","map":{"version":3,"names":[],"sources":["D:/FullStack_Ecommerce_App-main/frontend/src/components/Navbar.js"],"sourcesContent":["```javascript\nimport React from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { Navbar, Nav, Container, NavDropdown } from 'react-bootstrap'\nimport { LinkContainer } from 'react-router-bootstrap'\nimport { logout } from '../actions/userActions'\nimport { useHistory } from \"react-router-dom\"\nimport SearchBarForProducts from './SearchBarForProducts'\n\nfunction NavBar() {\n\n    let history = useHistory()\n    const dispatch = useDispatch()\n\n    const userLoginReducer = useSelector(\n        state => state.userLoginReducer\n    )\n\n    const { userInfo } = userLoginReducer\n\n    const logoutHandler = () => {\n        dispatch(logout())\n        history.push(\"/login\")\n        window.location.reload()\n    }\n\n    return (\n        <header>\n\n            <Navbar bg=\"dark\" variant=\"dark\" expand=\"lg\" collapseOnSelect>\n\n                <Container>\n\n                    <LinkContainer to=\"/\">\n                        <Navbar.Brand>\n                            <i className=\"mb-2 fas fa-home\"> Home</i>\n                        </Navbar.Brand>\n                    </LinkContainer>\n\n                    <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n\n                    <Navbar.Collapse id=\"basic-navbar-nav\">\n\n                        <Nav className=\"mr-auto\">\n\n                            <LinkContainer to=\"/\">\n                                <Nav.Link>\n                                    All Products\n                                </Nav.Link>\n                            </LinkContainer>\n\n                            {userInfo && userInfo.admin ? (\n                                <LinkContainer to=\"/new-product/\">\n                                    <Nav.Link>\n                                        Add Product\n                                    </Nav.Link>\n                                </LinkContainer>\n                            ) : null}\n\n                            <span>\n                                <SearchBarForProducts />\n                            </span>\n\n                        </Nav>\n\n                        {userInfo ? (\n\n                            <div>\n\n                                <NavDropdown\n                                    className=\"navbar-nav text-capitalize\"\n                                    title={userInfo.username}\n                                    id=\"username\"\n                                >\n\n                                    <LinkContainer to=\"/account\">\n                                        <NavDropdown.Item>\n                                            Account Settings\n                                        </NavDropdown.Item>\n                                    </LinkContainer>\n\n                                    <LinkContainer to=\"/all-addresses/\">\n                                        <NavDropdown.Item>\n                                            Address Settings\n                                        </NavDropdown.Item>\n                                    </LinkContainer>\n\n                                    <LinkContainer to=\"/stripe-card-details/\">\n                                        <NavDropdown.Item>\n                                            Card Settings\n                                        </NavDropdown.Item>\n                                    </LinkContainer>\n\n                                    <LinkContainer to=\"/all-orders/\">\n                                        <NavDropdown.Item>\n                                            All Orders\n                                        </NavDropdown.Item>\n                                    </LinkContainer>\n\n                                    <NavDropdown.Item onClick={logoutHandler}>\n                                        Logout\n                                    </NavDropdown.Item>\n\n                                </NavDropdown>\n\n                            </div>\n\n                        ) : (\n\n                            <LinkContainer to=\"/login\">\n                                <Nav.Link>\n                                    <i className=\"fas fa-user\"></i> Login\n                                </Nav.Link>\n                            </LinkContainer>\n\n                        )}\n\n                    </Navbar.Collapse>\n\n                </Container>\n\n            </Navbar>\n\n        </header>\n    )\n}\n\nexport default NavBar\n```\n"],"mappings":"AAAA,EAAE;AACF;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,CAAC,EAAE","ignoreList":[]},"metadata":{},"sourceType":"module"}