leErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"82"},{"filePath":"142","messages":"143","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"82"},{"filePath":"144","messages":"145","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"82"},{"filePath":"146","messages":"147","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"82"},{"filePath":"148","messages":"149","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"150"},{"filePath":"151","messages":"152","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"82"},{"filePath":"153","messages":"154","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"82"},{"filePath":"155","messages":"156","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"82"},{"filePath":"157","messages":"158","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"82"},{"filePath":"159","messages":"160","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"82"},{"filePath":"161","messages":"162","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"82"},"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\index.js",[],["163","164"],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\store.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\App.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\reducers\\index.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\LoginPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\CheckoutPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\ProductsListPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\CardDetailsPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\ProductDetailsPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\RegisterPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\AllAddressesOfUserPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\AccountPage.js",["165"],"import React, { useEffect } from 'react'\nimport { Link, useHistory } from 'react-router-dom'\nimport { useDispatch, useSelector } from 'react-redux'\nimport {\nuserDetails,\nlogout,\ncheckTokenValidation\n} from '../actions/userActions'\nimport Message from '../components/Message'\nimport { Spinner } from 'react-bootstrap'\n\nimport '../styles/Account.css'\n\nfunction AccountPage() {\n\n\nconst history = useHistory()\nconst dispatch = useDispatch()\n\n\n// TOKEN VALIDATION\nconst checkTokenValidationReducer = useSelector(\n    state => state.checkTokenValidationReducer\n)\n\nconst { error: tokenError } =\n    checkTokenValidationReducer\n\n\n// LOGIN DETAILS\nconst userLoginReducer = useSelector(\n    state => state.userLoginReducer\n)\n\nconst { userInfo } =\n    userLoginReducer\n\n\n// USER DETAILS\nconst userDetailsReducer = useSelector(\n    state => state.userDetailsReducer\n)\n\nconst {\n    user: userAccDetails,\n    loading\n} = userDetailsReducer\n\n\n// GET USER DETAILS\nuseEffect(() => {\n\n    if (!userInfo) {\n\n        history.push('/login')\n\n    } else {\n\n        dispatch(checkTokenValidation())\n\n        dispatch(\n            userDetails(userInfo.id)\n        )\n\n    }\n\n}, [history, userInfo, dispatch])\n\n\n// LOGOUT\nconst logoutHandler = () => {\n\n    dispatch(logout())\n\n    history.push('/login')\n\n}\n\n\n// TOKEN EXPIRED\nif (\n    userInfo &&\n    tokenError ===\n    'Request failed with status code 401'\n) {\n\n    alert(\n        'Session expired, please login again.'\n    )\n\n    dispatch(logout())\n\n    history.push('/login')\n\n    window.location.reload()\n\n}\n\n\n// LOADING\nif (loading) {\n\n    return (\n\n        <div className=\"account-loading\">\n\n            <Spinner animation=\"border\" />\n\n            <p>\n                Getting your profile...\n            </p>\n\n        </div>\n\n    )\n\n}\n\n\nreturn (\n\n    <div className=\"account-page\">\n\n\n        <div className=\"account-container\">\n\n\n            {/* PROFILE HEADER */}\n\n            <div className=\"account-header\">\n\n\n                <div className=\"account-avatar\">\n\n                    {userAccDetails?.username\n                        ? userAccDetails.username\n                            .charAt(0)\n                            .toUpperCase()\n                        : 'U'\n                    }\n\n                </div>\n\n\n                <div className=\"account-header-info\">\n\n                    <span className=\"account-small-title\">\n\n                        MY ACCOUNT\n\n                    </span>\n\n\n                    <h1>\n\n                        {userAccDetails?.username ||\n                            'User'}\n\n                    </h1>\n\n\n                    <p>\n\n                        Manage your profile and\n                        account settings\n\n                    </p>\n\n                </div>\n\n            </div>\n\n\n            {/* ACCOUNT DETAILS */}\n\n            <div className=\"account-details-card\">\n\n\n                <div className=\"account-section-heading\">\n\n                    <div>\n\n                        <h2>\n\n                            Profile Information\n\n                        </h2>\n\n\n                        <p>\n\n                            Your personal account details\n\n                        </p>\n\n                    </div>\n\n\n                    <span className=\"account-status\">\n\n                        ● Active\n\n                    </span>\n\n                </div>\n\n\n\n                {/* USERNAME */}\n\n                <div className=\"account-info-row\">\n\n                    <div className=\"account-info-icon\">\n\n                        👤\n\n                    </div>\n\n\n                    <div className=\"account-info-content\">\n\n                        <span>\n\n                            Username\n\n                        </span>\n\n\n                        <strong>\n\n                            {userAccDetails?.username ||\n                                'Not available'}\n\n                        </strong>\n\n                    </div>\n\n                </div>\n\n\n\n                {/* EMAIL */}\n\n                <div className=\"account-info-row\">\n\n                    <div className=\"account-info-icon\">\n\n                        ✉️\n\n                    </div>\n\n\n                    <div className=\"account-info-content\">\n\n                        <span>\n\n                            Email Address\n\n                        </span>\n\n\n                        <strong>\n\n                            {userAccDetails?.email ||\n                                'Not available'}\n\n                        </strong>\n\n                    </div>\n\n                </div>\n\n\n\n                {/* ACCOUNT TYPE */}\n\n                <div className=\"account-info-row\">\n\n                    <div className=\"account-info-icon\">\n\n                        🛡️\n\n                    </div>\n\n\n                    <div className=\"account-info-content\">\n\n                        <span>\n\n                            Account Type\n\n                        </span>\n\n\n                        <strong>\n\n                            {userAccDetails?.admin\n                                ? 'Administrator'\n                                : 'Customer'\n                            }\n\n                        </strong>\n\n                    </div>\n\n                </div>\n\n\n            </div>\n\n\n\n            {/* ACCOUNT ACTIONS */}\n\n            <div className=\"account-actions\">\n\n\n                {/* UPDATE */}\n\n                <Link\n                    to=\"/account/update\"\n                    className=\"account-update-btn\"\n                >\n\n                    <span>\n\n                        ✏️\n\n                    </span>\n\n                    Update Account\n\n                </Link>\n\n\n\n                {/* DELETE */}\n\n                <Link\n                    to=\"/account/delete/\"\n                    className=\"account-delete-btn\"\n                >\n\n                    <span>\n\n                        🗑️\n\n                    </span>\n\n                    Delete Account\n\n                </Link>\n\n\n                {/* LOGOUT */}\n\n                <button\n                    onClick={logoutHandler}\n                    className=\"account-logout-btn\"\n                >\n\n                    <span>\n\n                        ↪\n\n                    </span>\n\n                    Logout\n\n                </button>\n\n\n            </div>\n\n\n\n            {/* SECURITY */}\n\n            <div className=\"account-security\">\n\n                <span>\n\n                    🔒\n\n                </span>\n\n\n                <p>\n\n                    Your account information is securely protected.\n\n                </p>\n\n            </div>\n\n\n        </div>\n\n\n    </div>\n\n)\n\n\n}\n\nexport default AccountPage\n","D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\AccountUpdatePage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\NotFoundPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\DeleteUserAccountPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\CardUpdatePage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\OrdersListPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\ProductCreatePage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\ProductUpdatePage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\PaymentStatus.js",["166"],"import React from 'react'\nimport { Card, Button } from 'react-bootstrap'\nimport { useLocation, useHistory } from 'react-router-dom'\nimport { Link } from 'react-router-dom'\nimport Message from './Message'\n\nimport './PaymentStatus.css'\n\nconst PaymentStatus = () => {\n\n\nconst location = useLocation()\nconst history = useHistory()\n\nconst boughtData =\n    location.state && location.state.detail\n        ? location.state.detail\n        : null\n\n\nif (!boughtData) {\n    return (\n        <div className=\"payment-status-page\">\n\n            <Card className=\"payment-status-card\">\n\n                <div className=\"status-icon error-icon\">\n                    !\n                </div>\n\n                <h2>Payment Status Not Available</h2>\n\n                <p>\n                    We couldn't find your payment details.\n                </p>\n\n                <Button\n                    variant=\"primary\"\n                    onClick={() => history.push('/')}\n                >\n                    Go to Home\n                </Button>\n\n            </Card>\n\n        </div>\n    )\n}\n\n\nreturn (\n\n    <div className=\"payment-status-page\">\n\n        <Card className=\"payment-status-card\">\n\n            <div className=\"success-circle\">\n                ✓\n            </div>\n\n\n            <span className=\"success-label\">\n                PAYMENT SUCCESSFUL\n            </span>\n\n\n            <h1>\n                Thank You for Your Order!\n            </h1>\n\n\n            <p className=\"success-description\">\n                Your payment has been completed successfully.\n                Your order is now being processed.\n            </p>\n\n\n            <div className=\"order-success-box\">\n\n                <div className=\"order-success-row\">\n\n                    <span>\n                        Product\n                    </span>\n\n                    <strong>\n                        {boughtData.name}\n                    </strong>\n\n                </div>\n\n\n                <div className=\"success-divider\"></div>\n\n\n                <div className=\"order-success-row\">\n\n                    <span>\n                        Amount Paid\n                    </span>\n\n                    <strong className=\"paid-price\">\n                        ₹ {boughtData.price}\n                    </strong>\n\n                </div>\n\n\n                <div className=\"success-divider\"></div>\n\n\n                <div className=\"order-success-row\">\n\n                    <span>\n                        Payment Status\n                    </span>\n\n                    <strong className=\"paid-status\">\n                        ✓ Paid\n                    </strong>\n\n                </div>\n\n            </div>\n\n\n            <div className=\"success-message\">\n\n                <span>\n                    📦\n                </span>\n\n                <p>\n                    Your order details are available in\n                    your orders page.\n                </p>\n\n            </div>\n\n\n            <div className=\"success-actions\">\n\n                <Link to=\"/all-orders/\">\n\n                    <Button\n                        variant=\"primary\"\n                        className=\"orders-button\"\n                    >\n                        View My Orders\n                    </Button>\n\n                </Link>\n\n\n                <Button\n                    variant=\"outline-secondary\"\n                    className=\"continue-button\"\n                    onClick={() => history.push('/')}\n                >\n                    Continue Shopping\n                </Button>\n\n            </div>\n\n        </Card>\n\n    </div>\n)\n\n\n}\n\nexport default PaymentStatus\n","D:\\FullStack_Ecommerce_App-main\\frontend\\src\\pages\\AddressUpdatePage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\Navbar.js",["167"],"import React, { useState } from 'react'\nimport { useHistory } from 'react-router-dom'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { USER_LOGOUT } from '../constants'\nimport './Navbar.css'\n\nfunction NavBar() {\n\n    const history = useHistory()\n    const dispatch = useDispatch()\n\n    // =========================================\n    // REDUX USER DATA\n    // =========================================\n\n    const userLoginReducer = useSelector(\n        state => state.userLoginReducer\n    )\n\n    const { userInfo } = userLoginReducer\n\n\n    // =========================================\n    // SEARCH STATE\n    // =========================================\n\n    const [search, setSearch] = useState('')\n\n\n    // =========================================\n    // SEARCH HANDLER\n    // =========================================\n\n    const searchHandler = (e) => {\n\n        e.preventDefault()\n\n        const searchValue = search.trim()\n\n        if (searchValue) {\n\n            history.push(\n                '/?searchTerm=' +\n                encodeURIComponent(searchValue)\n            )\n\n        } else {\n\n            history.push('/')\n\n        }\n\n    }\n\n\n    // =========================================\n    // PROFILE CLICK\n    // =========================================\n\n    const profileHandler = () => {\n\n        if (userInfo) {\n\n            history.push('/account')\n\n        } else {\n\n            history.push('/login')\n\n        }\n\n    }\n\n\n    // =========================================\n    // LOGOUT\n    // =========================================\n\n    const logoutHandler = () => {\n\n        localStorage.removeItem('userInfo')\n\n        dispatch({\n            type: 'USER_LOGOUT'\n        })\n\n        history.push('/')\n\n    }\n\n\n    return (\n\n        <header className=\"shopease-navbar\">\n\n            {/* =========================================\n                MAIN NAVBAR\n            ========================================= */}\n\n            <div className=\"navbar-container\">\n\n\n                {/* LOGO */}\n\n                <div\n                    className=\"shopease-logo\"\n                    onClick={() => history.push('/')}\n                >\n\n                    <div className=\"logo-icon\">\n                        🛍️\n                    </div>\n\n                    <div className=\"logo-text\">\n\n                        <h2>\n                            Shop<span>Ease</span>\n                        </h2>\n\n                        <p>\n                            Shop • Smile • Repeat\n                        </p>\n\n                    </div>\n\n                </div>\n\n\n                {/* =========================================\n                    SEARCH\n                ========================================= */}\n\n                <form\n                    className=\"navbar-search\"\n                    onSubmit={searchHandler}\n                >\n\n                    <span className=\"navbar-search-icon\">\n                        🔍\n                    </span>\n\n                    <input\n                        type=\"text\"\n                        placeholder=\"Search for products, brands and more\"\n                        value={search}\n                        onChange={(e) =>\n                            setSearch(e.target.value)\n                        }\n                    />\n\n                    <button type=\"submit\">\n                        Search\n                    </button>\n\n                </form>\n\n\n                {/* =========================================\n                    RIGHT SIDE\n                ========================================= */}\n\n                <div className=\"navbar-actions\">\n\n\n                    {/* PROFILE */}\n\n                    <div\n                        className=\"profile-action\"\n                        onClick={profileHandler}\n                    >\n\n                        <span className=\"action-icon\">\n                            👤\n                        </span>\n\n                        <div>\n\n                            <small>\n                                Hello,\n                            </small>\n\n                            <strong>\n\n                                {userInfo\n                                    ? userInfo.username\n                                    : 'Login'\n                                }\n\n                            </strong>\n\n                        </div>\n\n                    </div>\n\n\n                    {/* LOGOUT - ONLY AFTER LOGIN */}\n\n                    {userInfo && (\n\n                        <button\n                            className=\"logout-btn\"\n                            onClick={logoutHandler}\n                        >\n\n                            Logout\n\n                        </button>\n\n                    )}\n\n\n                    {/* CART */}\n\n                    <div\n                        className=\"cart-action\"\n                        onClick={() =>\n                            alert('Cart feature coming soon')\n                        }\n                    >\n\n                        <div className=\"cart-icon-wrapper\">\n\n                            🛒\n\n                            <span className=\"cart-count\">\n                                0\n                            </span>\n\n                        </div>\n\n                        <strong>\n                            Cart\n                        </strong>\n\n                    </div>\n\n\n                </div>\n\n            </div>\n\n\n            {/* =========================================\n                CATEGORY NAVBAR\n            ========================================= */}\n\n            <div className=\"category-navbar\">\n\n\n                <button\n                    onClick={() => history.push('/')}\n                >\n                    Popular\n                </button>\n\n\n                <button\n                    onClick={() =>\n                        history.push('/?category=Women')\n                    }\n                >\n                    Women\n                </button>\n\n\n                <button\n                    onClick={() =>\n                        history.push('/?category=Men')\n                    }\n                >\n                    Men\n                </button>\n\n\n                <button\n                    onClick={() =>\n                        history.push(\n                            '/?category=Home%20%26%20Kitchen'\n                        )\n                    }\n                >\n                    Home & Kitchen\n                </button>\n\n\n                <button\n                    onClick={() =>\n                        history.push('/?category=Beauty')\n                    }\n                >\n                    Beauty\n                </button>\n\n\n                <button\n                    onClick={() =>\n                        history.push('/?category=Bags')\n                    }\n                >\n                    Bags\n                </button>\n\n\n                <button\n                    onClick={() =>\n                        history.push('/?category=Footwear')\n                    }\n                >\n                    Footwear\n                </button>\n\n\n                <button\n                    onClick={() =>\n                        history.push('/?category=Electronics')\n                    }\n                >\n                    Electronics\n                </button>\n\n\n                <button\n                    onClick={() =>\n                        history.push('/?category=Watches')\n                    }\n                >\n                    Watches\n                </button>\n\n\n            </div>\n\n        </header>\n\n    )\n}\n\nexport default NavBar","D:\\FullStack_Ecommerce_App-main\\frontend\\src\\reducers\\productReducers.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\reducers\\cardReducers.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\UserAddressComponent.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\reducers\\userReducers.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\CreateCardComponent.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\ChargeCardComponent.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\Message.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\Product.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\DeleteCardComponent.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\CreateAddressComponent.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\SearchBarForProducts.js",[],["168","169"],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\GetDate.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\components\\SearchBarForOrdersPage.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\constants\\index.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\actions\\productActions.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\actions\\userActions.js",[],"D:\\FullStack_Ecommerce_App-main\\frontend\\src\\actions\\cardActions.js",[],{"ruleId":"170","replacedBy":"171"},{"ruleId":"172","replacedBy":"173"},{"ruleId":"174","severity":1,"message":"175","line":9,"column":8,"nodeType":"176","messageId":"177","endLine":9,"endColumn":15},{"ruleId":"174","severity":1,"message":"175","line":5,"column":8,"nodeType":"176","messageId":"177","endLine":5,"endColumn":15},{"ruleId":"174","severity":1,"message":"178","line":4,"column":10,"nodeType":"176","messageId":"177","endLine":4,"endColumn":21},{"ruleId":"170","replacedBy":"179"},{"ruleId":"172","replacedBy":"180"},"no-native-reassign",["181"],"no-negated-in-lhs",["182"],"no-unused-vars","'Message' is defined but never used.","Identifier","unusedVar","'USER_LOGOUT' is defined but never used.",["181"],["182"],"no-global-assign","no-unsafe-negation"]